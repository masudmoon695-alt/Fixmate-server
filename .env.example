PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (include the database name or use DB_NAME)
MONGODB_URI=
DB_NAME=fixmate

# Must match the JWT secret used by the BetterAuth client
JWT_SECRET=

# Comma separated list is allowed
CLIENT_URL=http://localhost:3000

# Stripe test mode only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImgBB uploads happen on the client; the server only stores URLs
IMGBB_API_KEY=

# Password used by the seed script for seeded accounts (optional)
SEED_PASSWORD=Fixmate@1234
